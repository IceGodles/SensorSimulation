// Encodes the 8-bit CustomStencil semantic label directly into linear RGBA8.
// Integer texel loads avoid filtering, neighborhood mixing, and color transforms.
#include "/Engine/Private/ScreenPass.ush"
#include "/Engine/Private/SceneTexturesCommon.ush"

void MainPS(
    noperspective float4 UVAndScreenPos : TEXCOORD0, // VS输出的归一化UV，直接在屏幕空间中线性插值，不执行透视校正。
    float4 SvPosition : SV_POSITION, // 光栅化生成的像素坐标
    out float4 OutColor : SV_Target0)
{
    // FScreenPassVS outputs TEXCOORD0 before SV_POSITION. D3D12 requires the
    // pixel-shader input signature to preserve those hardware-register slots.
    //
    // Use the effective ViewRect rather than the pooled scene-texture extent:
    // RDG can allocate a texture larger than an odd-sized capture viewport.
    const uint2 ViewSize = uint2(View.ViewSizeAndInvSize.xy);
    const uint2 PixelPos = uint2(View.ViewRectMin.xy) + min(
        uint2(UVAndScreenPos.xy * float2(ViewSize)),
        ViewSize - 1);
    const uint SemanticId = CalcSceneCustomStencil(PixelPos);
    OutColor = float4(float(SemanticId) / 255.0f, 0.0f, 0.0f, 1.0f);
}
