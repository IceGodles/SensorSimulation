+++ b/Engine/Source/Runtime/Renderer/Private/PostProcess/PostProcessing.cpp
@@ -59,6 +59,18 @@
 #include "MobileDistortionPass.h"
 #include "ScenePrivate.h"
 
+namespace
+{
+	/** Valid only on the render thread while AddPostProcessingPasses is on the stack. */
+	const UE::Renderer::PostProcess::FExtensionContext* GPostProcessingExtensionContext = nullptr;
+}
+
+const UE::Renderer::PostProcess::FExtensionContext* UE::Renderer::PostProcess::GetExtensionContext_RenderThread()
+{
+	check(IsInRenderingThread());
+	return GPostProcessingExtensionContext;
+}
+
 #include "SceneTextureParameters.h"
 #include "PixelShaderUtils.h"
 #include "ScreenSpaceRayTracing.h"
@@ -375,6 +387,8 @@ void AddPostProcessingPasses(
 	using namespace UE::Renderer::PostProcess;
 
